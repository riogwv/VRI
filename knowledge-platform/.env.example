# =============================================================================
# Knowledge Platform — Environment variables (example, no secrets)
# Copy this file to .env and fill in your own values.
# Never commit .env to version control.
# =============================================================================

# Supabase (required for auth, profiles, bookmarks, reactions, comments)
# Get these from your Supabase project dashboard > Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Edge Function URL for GNews proxy (configured in Supabase dashboard)
VITE_EDGE_FUNCTION_URL=https://your-project.supabase.co/functions/v1/news-proxy

# Optional: direct Jikan API (public, no key). Kept here for easy override.
VITE_JIKAN_API_BASE=https://api.jikan.moe/v4

# Optional: direct Wikidata REST API (public, no key)
VITE_WIKIDATA_API_BASE=https://www.wikidata.org/w/rest.php/wikibase/v1

# Optional: direct Lichess API (public, anonymous OK)
VITE_LICHESS_API_BASE=https://lichess.org/api